# Copy this file to .env and fill in your own values. Never commit .env.

# Any long random string, used to sign the login session cookie.
SESSION_SECRET=any-long-random-string

# Your PostgreSQL connection string (for example from Neon).
DATABASE_URL=your-postgres-connection-string

# Optional: lets a script save data without a password.
# API_KEY: at least 32 random characters, e.g. from
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_USER_ID: the userId shown at /api/whoami when logged in.
# Leave both out to keep the feature off.
API_KEY=your-long-random-key
API_USER_ID=your-user-id
